# Without backend configuration the new routes run in a clearly labeled, synthetic demo.
# For Vercel production use production, then configure both Supabase public values.
VITE_DATA_MODE=demo
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Use the project's publishable/anon key only. Never put a service_role or secret key in VITE_*.
